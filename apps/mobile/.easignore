# Keep the standard project exclusions. EAS gives this file precedence over
# .gitignore, so it must repeat the relevant rules.

# Dependencies and Expo working data
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders are generated by Expo Prebuild on EAS from app.json/config
# plugins. They are large local build artifacts and must not be uploaded.
/android
/ios
.kotlin/

# Local environment and credentials. Provide EXPO_PUBLIC_* values as EAS
# environment variables/secrets; do not upload this project's .env file.
.env
.env.*
!.env.example
*.local
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Tooling, logs, and OS files
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.orig.*
*.tsbuildinfo
coverage/
test-results/
playwright-report/
