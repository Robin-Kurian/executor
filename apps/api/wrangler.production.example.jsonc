{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "executor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "VAPID_SUBJECT"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "WEB_ORIGIN": "https://your-web.example.com",
    "BETTER_AUTH_URL": "https://your-api.example.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "triggers": {
    "crons": ["*/10 * * * *", "30 2 * * *", "30 13 * * *"]
  },
  "routes": [
    {
      "pattern": "your-api.example.com",
      "custom_domain": true
    }
  ]
}
