{
  "name": "executor",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @executor/web",
    "dev:api": "npm run dev -w @executor/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @executor/api",
    "db:migrate": "npm run db:migrate -w @executor/api",
    "api:deploy": "npm run deploy -w @executor/api -- --env production",
    "web:deploy": "npm run deploy -w @executor/web"
  },
  "devDependencies": {
    "concurrently": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": { "node": ">=20.9" }
}
